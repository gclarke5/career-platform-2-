# systemd unit for the AWS EC2 server. Install with:
#   sudo cp deploy/career-platform.service /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=gavinclarke.me (FastAPI via uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/career-platform
# DATABASE_URL, ENVIRONMENT=production, GA_MEASUREMENT_ID, GIT_COMMIT_SHA. root:ubuntu, mode 640, never in Git.
EnvironmentFile=/etc/career-platform.env
# Bound to localhost only: nginx is the sole public entry point and the one trusted proxy.
ExecStart=/home/ubuntu/career-platform/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
